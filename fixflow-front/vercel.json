{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://fixflow-s8d1.onrender.com" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
