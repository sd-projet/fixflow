# Valeurs par défaut (écrasées par les variables d'environnement Docker / CI).
# Les blocs ### sont les marqueurs Symfony Flex : leur présence évite que les recettes
# n'ajoutent leurs propres valeurs par défaut.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me-in-production
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://fixflow:fixflow@db:5432/fixflow?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default
###< symfony/messenger ###
